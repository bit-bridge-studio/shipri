# Backend POC Environment Configuration
# Applies to local development and restricted Backend POC staging (poc.shipri.app).
# POC staging is a pre-production test environment with no production traffic or secrets.
# Copy to .env for local or staging overrides. Do not commit .env or secret values.

PORT=5001

# Comma-separated HTTP(S) origins allowed for Express and Socket.IO CORS.
# Local development default:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Restricted POC staging example (rejects https://shipri.app and wildcards):
# ALLOWED_ORIGINS=https://poc.shipri.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Comma-separated public STUN endpoints returned by the Backend POC ice:get flow
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Production TURN credentials and TURN_SHARED_SECRET are deferred to full backend development.
