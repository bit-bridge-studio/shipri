# Server Environment Configuration Blueprint
PORT=5001
NODE_ENV=development

# Credentials secret matching 'static-auth-secret' inside turnserver.conf
TURN_SHARED_SECRET=your_super_strong_shared_secret_here

# ICE relay configurations returned dynamically to clients
TURN_SERVER_URL=turn:turn.shipri.app:3478?transport=udp
TURN_SERVER_URL_TCP=turn:turn.shipri.app:3478?transport=tcp
TURNS_SERVER_URL=turns:turn.shipri.app:443?transport=tcp
