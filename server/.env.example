# Shipri Signaling Server Environment Configuration Template
# Copy to .env for local or deployment overrides. Do not commit .env or secret values.

NODE_ENV=development
PORT=5001

# Comma-separated HTTP(S) origins allowed for Express and Socket.IO CORS (wildcards forbidden).
# Local development default:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production example:
# ALLOWED_ORIGINS=https://shipri.app

# Express / Socket.IO proxy trust boundary (false for direct runs, 1 behind Caddy or nginx-proxy).
TRUST_PROXY=false

# Room authorization enforcement (required true when NODE_ENV=production; false only in POC/dev).
REQUIRE_ROOM_AUTH=false

# Room capacity, idle TTL, maximum lifetime, and cleanup sweep settings (milliseconds).
MAX_ROOMS=5000
ROOM_IDLE_TTL_MS=1800000
ROOM_MAX_LIFETIME_MS=14400000
ROOM_CLEANUP_INTERVAL_MS=60000

# Per-IP room:create rate-limit cap and window (milliseconds).
ROOM_CREATE_RATE_LIMIT_MAX=10
ROOM_CREATE_RATE_LIMIT_WINDOW_MS=60000

# Comma-separated STUN endpoints returned by ice:get.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Full-backend Coturn TURN/TURNS endpoints and dynamic REST HMAC-SHA1 credential settings.
# Leave TURN_URLS empty and REQUIRE_TURN=false for STUN-only development.
TURN_URLS=
TURN_CREDENTIAL_TTL_SECONDS=7200
REQUIRE_TURN=false

# Inject TURN_SHARED_SECRET exclusively via host environment or secret manager.
# Never commit real secret values to git.
# TURN_SHARED_SECRET=
